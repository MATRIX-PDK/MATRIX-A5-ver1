# =====================================================================
# VIA <name> DEFAULT — fixed via masters
# Required for Innovus power-rail / fixed-via instantiation.
# =====================================================================

VIA VTSV_0 DEFAULT
  LAYER BPR ;
    RECT -0.045 -0.012 0.045 0.012 ;
  LAYER TSV ;
    RECT -0.045 -0.045 0.045 0.045 ;
  LAYER BSM1 ;
    RECT -0.100 -0.045 0.100 0.045 ;
END VTSV_0

VIA VBSV1_0 DEFAULT
  LAYER BSV1 ;
    RECT -0.100 -0.100 0.100 0.100 ;
  LAYER BSM1 ;
    RECT -0.100 -0.100 0.100 0.100 ;
  LAYER BSM2 ;
    RECT -0.100 -0.250 0.100 0.250 ;
END VBSV1_0

VIA VBSV2_0 DEFAULT
  LAYER BSV2 ;
    RECT -0.250 -0.250 0.250 0.250 ;
  LAYER BSM2 ;
    RECT -0.250 -0.250 0.250 0.250 ;
  LAYER BSM3 ;
    RECT -0.500 -0.250 0.500 0.250 ;
END VBSV2_0

# VBPR_0 — "blessed" BPR↔M0 via macro REQUIRED BY INNOVUS NanoRoute.
# Physically, VBPR connects SDCON↔BPR (not M0↔BPR); the chip-level path
# from BPR to M0 actually goes BPR→VBPR→SDCON→VSD→M0 (two cuts) and is
# drawn inside each std-cell GDS. We do NOT need Innovus to stitch
# BPR↔M0 in empty area (BSPDN supplies power via TSV→BPR, cells pick up
# internally, M0 grid is continuous between cells). HOWEVER: NanoRoute
# walks the routable-layer stack pair-by-pair and errors NRDB-158
# "Missing vias from LAYER BPR to LAYER M0 in RULE LEF_DEFAULT" if there
# is no via between adjacent routable layers. So this macro must be
# present as a "logical abstraction" of the in-cell stack even though
# Innovus never actually stamps it during routing in empty area. Do not remove.
VIA VBPR_0 DEFAULT
  LAYER VBPR ;
    RECT -0.006 -0.006 0.006 0.006 ;
  LAYER BPR ;
    RECT -0.011 -0.006 0.011 0.006 ;
  LAYER M0 ;
    RECT -0.011 -0.006 0.011 0.006 ;
END VBPR_0

VIA via13 DEFAULT
  LAYER V13 ;
    RECT -0.028 -0.028 0.028 0.028 ;
  LAYER M13 ;
    RECT -0.028 -0.04 0.028 0.04 ;
  LAYER RDL ;
    RECT -0.04 -0.028 0.04 0.028 ;
END via13

VIA via12_13 DEFAULT
  LAYER V12 ;
    RECT -0.028 -0.028 0.028 0.028 ;
  LAYER M12 ;
