  SPACING 0.007 ;
  WIDTH 0.009 ;
END V0

LAYER M1
  TYPE ROUTING ;
  DIRECTION VERTICAL ;
  PITCH 0.026 0.026 ;
  WIDTH 0.016 ;
  OFFSET 0.013 0.013 ;
  AREA 0.000448 ;
  SPACING 0.010 ;
END M1

LAYER V1
  TYPE CUT ;
  SPACING 0.007 ;
  WIDTH 0.009 ;
END V1

LAYER M2
  TYPE ROUTING ;
  DIRECTION HORIZONTAL ;
  PITCH 0.016 0.016 ;
  WIDTH 0.009 ;
  OFFSET 0.008 0.008 ;
  AREA 0.000216 ;
  SPACING 0.007 ;
END M2

LAYER V2
  TYPE CUT ;
  SPACING 0.007 ;
  WIDTH 0.009 ;
END V2

LAYER M3
