VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;

PROPERTYDEFINITIONS
  LAYER LEF58_TYPE STRING ;
  LAYER LEF58_SPACING STRING ;
  LAYER LEF58_WIDTH STRING ;
END PROPERTYDEFINITIONS

UNITS
  DATABASE MICRONS 2000 ;
END UNITS
MANUFACTURINGGRID 0.0005 ;
LAYER OVERLAP
  TYPE OVERLAP ;
END OVERLAP

# =====================================================================
# MASTERSLICE — FEOL well/diffusion/poly/select/cuts
#  CFET has TWO device tiers; layers with a "2" suffix belong to the
#  upper tier (e.g. nFET-over-pFET stack, GATE2 = upper-tier poly).
# =====================================================================

LAYER NWELL
  TYPE MASTERSLICE ;
  PROPERTY LEF58_TYPE "TYPE NWELL ;" ;
  PROPERTY LEF58_SPACING "SPACING 0.039 ;" ;
  PROPERTY LEF58_WIDTH "WIDTH 0.039 ;" ;
END NWELL

LAYER ACT
  TYPE MASTERSLICE ;
  PROPERTY LEF58_TYPE "TYPE DIFFUSION ;" ;
  PROPERTY LEF58_SPACING "SPACING 0.03 ;" ;
  PROPERTY LEF58_WIDTH "WIDTH 0.011 ;" ;
END ACT

LAYER ACT2
  TYPE MASTERSLICE ;
  PROPERTY LEF58_TYPE "TYPE DIFFUSION ;" ;
  PROPERTY LEF58_SPACING "SPACING 0.03 ;" ;
  PROPERTY LEF58_WIDTH "WIDTH 0.011 ;" ;
END ACT2

LAYER GATE
  TYPE MASTERSLICE ;
END GATE

LAYER GATE2
  TYPE MASTERSLICE ;
END GATE2

LAYER DUMMY
  TYPE MASTERSLICE ;
END DUMMY

LAYER GCUT
  TYPE MASTERSLICE ;
END GCUT

LAYER NSEL
  TYPE MASTERSLICE ;
END NSEL

LAYER PSEL
  TYPE MASTERSLICE ;
END PSEL

LAYER SDCON
  TYPE MASTERSLICE ;
  PROPERTY LEF58_TYPE "TYPE MEOL ;" ;
END SDCON

LAYER SDCON2
  TYPE MASTERSLICE ;
  PROPERTY LEF58_TYPE "TYPE MEOL ;" ;
END SDCON2

LAYER GSMERGE
  TYPE MASTERSLICE ;
  PROPERTY LEF58_TYPE "TYPE MEOL ;" ;
END GSMERGE

LAYER FNCut
  TYPE MASTERSLICE ;
END FNCut

# =====================================================================
# CUT — FEOL via/contact layers
#  Two-tier device adds the "2" / "12" cuts:
#    VG12  — gate via between tier-1 GATE and tier-2 GATE2
#    VG2   — gate-to-M0 via on the upper tier
#    VSD2  — S/D contact via on the upper tier
#    VBPR2 — upper-tier S/D to BPR via
# =====================================================================

LAYER VSD
  TYPE CUT ;
  SPACING 0.012 ;
  WIDTH 0.012 ;
END VSD

LAYER VSD2
  TYPE CUT ;
  SPACING 0.012 ;
  WIDTH 0.012 ;
END VSD2

LAYER VG
  TYPE CUT ;
  SPACING 0.012 ;
  WIDTH 0.012 ;
END VG

LAYER VG2
  TYPE CUT ;
  SPACING 0.012 ;
  WIDTH 0.012 ;
END VG2

LAYER VG12
  TYPE CUT ;
  SPACING 0.012 ;
  WIDTH 0.012 ;
END VG12

LAYER VBPR2
  TYPE CUT ;
  SPACING 0.012 ;
  WIDTH 0.012 ;
END VBPR2

# =====================================================================
# Backside ROUTING — BSPDN stack (package -> silicon)
# Process-independent BSPDN geometry.
# =====================================================================

LAYER BSM3
  TYPE ROUTING ;
  SPACING 1.0 ;
  WIDTH 1.0 ;
  PITCH 2.0 ;
  DIRECTION VERTICAL  ;
  OFFSET 1.0 ;
END BSM3

LAYER BSV2
  TYPE CUT ;
  SPACING 0.4 ;
  WIDTH 0.4 ;
END BSV2

LAYER BSM2
  TYPE ROUTING ;
  SPACING 1.1 ;
  WIDTH 0.5 ;
  PITCH 1.6 ;
  DIRECTION HORIZONTAL  ;
  OFFSET 0.8 ;
END BSM2

LAYER BSV1
  TYPE CUT ;
  SPACING 0.2 ;
  WIDTH 0.2 ;
END BSV1

LAYER BSM1
  TYPE ROUTING ;
  SPACING 0.8 ;
  WIDTH 0.2 ;
  PITCH 1.0 ;
  DIRECTION VERTICAL  ;
  OFFSET 0.5 ;
END BSM1

LAYER TSV
  TYPE CUT ;
  SPACING 0.02 ;
  WIDTH 0.02 ;
END TSV

# =====================================================================
# BPR — buried power rail, std-cell PG layer
#  CFET 5-track cell height = 0.088 µm. One BPR per std-cell row, therefore:
#    PITCH   = cell_height           = 0.088
#    WIDTH   = 0.024
#    SPACING = PITCH - WIDTH         = 0.064
#    DIRECTION HORIZONTAL (row-direction; horizontal cells)
# =====================================================================

LAYER BPR
  TYPE ROUTING ;
  SPACING 0.064 ;
  WIDTH 0.024 ;
  PITCH 0.088 ;
  DIRECTION HORIZONTAL  ;
  OFFSET 0 ;
END BPR

LAYER VBPR
  TYPE CUT ;
  SPACING 0.012 ;
  WIDTH 0.012 ;
END VBPR

# =====================================================================
# Frontside ROUTING — M0..M13 + V0..V13 + RDL
# Process-independent BEOL geometry.
# M1/M2 SPACING + PITCH consistent (PITCH = WIDTH + SPACING).
# M2 mirrors M0 (HORIZONTAL, 9 nm wire, 16 nm pitch).
# =====================================================================

LAYER M0
  TYPE ROUTING ;
  DIRECTION HORIZONTAL ;
  PITCH 0.016 0.016 ;
  WIDTH 0.009 ;
  OFFSET 0.008 0.008 ;
  AREA 0.000216 ;
  SPACING 0.007 ;
END M0

LAYER V0
