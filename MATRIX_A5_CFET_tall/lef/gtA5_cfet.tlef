# FEOL contact-array generators (geometry from the Virtuoso techfile standardViaDefs).

VIARULE polyCont GENERATE DEFAULT
  LAYER GATE ;
    ENCLOSURE 0 0.004 ;
  LAYER M0 ;
    ENCLOSURE 0.004 0 ;
  LAYER VG ;
    RECT -0.0045 -0.0045 0.0045 0.0045 ;
    SPACING 0.036 BY 0.021 ;
END polyCont

VIARULE diffCont GENERATE DEFAULT
  LAYER SDCON ;
    ENCLOSURE 0.001 0 ;
  LAYER M0 ;
    ENCLOSURE 0.004 0 ;
  LAYER VSD ;
    RECT -0.0045 -0.0045 0.0045 0.0045 ;
    SPACING 0.038 BY 0.021 ;
END diffCont

# vbprCont — BPR↔M0 generate VIARULE companion to VIA VBPR_0 DEFAULT.
# Same reasoning: Innovus's NanoRoute requires a via-generate rule
# between every adjacent pair of routable layers (BPR + M0) or it
# errors NRDB-158 at routing start. This is a "logical abstraction" of
# the in-cell BPR→VBPR→SDCON→VSD→M0 stack; Innovus uses it for
# connectivity bookkeeping but does not stamp BPR↔M0 cut arrays in
# empty area during power-stripe routing (BSPDN handles power via
# TSV→BPR; M0 power grid is continuous between cell rows). Do not remove.
VIARULE vbprCont GENERATE DEFAULT
  LAYER BPR ;
    ENCLOSURE 0.003 0 ;
  LAYER M0 ;
    ENCLOSURE 0.005 0 ;
  LAYER VBPR ;
    RECT -0.006 -0.006 0.006 0.006 ;
    SPACING 0.024 BY 0.024 ;
END vbprCont

VIARULE viaTSV GENERATE DEFAULT
  LAYER BPR ;
    ENCLOSURE 0 0 ;
  LAYER BSM1 ;
    ENCLOSURE 0.015 0.015 ;
  LAYER TSV ;
    RECT -0.045 -0.045 0.045 0.045 ;
    SPACING 0.18 BY 0.18 ;
END viaTSV

VIARULE viaBSV1 GENERATE DEFAULT
  LAYER BSM1 ;
    ENCLOSURE 0.05 0.05 ;
  LAYER BSM2 ;
    ENCLOSURE 0.15 0.15 ;
  LAYER BSV1 ;
    RECT -0.1 -0.1 0.1 0.1 ;
    SPACING 0.4 BY 0.4 ;
END viaBSV1

VIARULE viaBSV2 GENERATE DEFAULT
  LAYER BSM2 ;
    ENCLOSURE 0.25 0.25 ;
  LAYER BSM3 ;
    ENCLOSURE 0.75 0.75 ;
  LAYER BSV2 ;
    RECT -0.25 -0.25 0.25 0.25 ;
    SPACING 1 BY 1 ;
END viaBSV2

# =====================================================================
# SITE — std-cell row footprint
# CFET 5-track cell height = 0.088 µm (vs NS 0.096 = 6-track NS standard).
# One BPR per row -> BPR PITCH = SITE Y.
# =====================================================================

SITE CORESITE_5t_32
  CLASS CORE ;
  SYMMETRY Y ;
  SIZE 0.039 BY 0.088 ;
END CORESITE_5t_32

END LIBRARY
